# Copia este archivo como ".env" y completa tus valores. El ".env" NO se sube a git.

# Conexion a MySQL (SSL obligatorio en servicios como Aiven)
DB_HOST=tu-servidor.ejemplo.com
DB_PORT=3306
# Base de datos de la aplicacion: el cargador la crea si no existe (solo letras, numeros y _)
DB_NAME=facturacion
DB_USER=tu_usuario
DB_PASSWORD=tu_contrasena
DB_SSL_MODE=Required

# Porcentaje de IVA aplicado a las facturas
IVA_PORCENTAJE=13

# Usuario administrador que crea el cargador en una base limpia (cambia la clave)
ADMIN_USER=admin
ADMIN_PASSWORD=CambiaEstaClave1
ADMIN_FULLNAME=Administrador del sistema
